# Stage 1: Build static assets using Node 20
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY railpulse-ai/package*.json ./

# Install npm dependencies cleanly
RUN npm ci

# Copy web application source code
COPY railpulse-ai/ ./

# Build production bundle
RUN npm run build

# Stage 2: Serve via Nginx
FROM nginx:alpine

# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy built distribution from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration with reverse proxy for FastAPI
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Expose web port 8000
EXPOSE 8000

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]

